# Server Configuration
SERVER_PORT=18080
SERVER_MODE=development

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pathmind
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_MAX_CONN_POOL_SIZE=50

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# Agent Gateway Resilience
AGENT_SERVICE_URL=http://localhost:9090
AGENT_SERVICE_REQUEST_TIMEOUT_SEC=120
AGENT_SERVICE_RESPONSE_HEADER_TIMEOUT_SEC=30
AGENT_SERVICE_STREAM_HEADER_TIMEOUT_SEC=45
AGENT_SERVICE_MAX_IDLE_CONNS=200
AGENT_SERVICE_MAX_IDLE_CONNS_PER_HOST=50
AGENT_SERVICE_IDLE_CONN_TIMEOUT_SEC=90
AGENT_SERVICE_CB_FAILURE_THRESHOLD=5
AGENT_SERVICE_CB_OPEN_SEC=20

# Agent API Rate Limiting
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SEC=60
AGENT_PUBLIC_RATE_LIMIT_REQUESTS=10
AGENT_PUBLIC_RATE_LIMIT_WINDOW_SEC=60

# Agent Metrics History Persistence
AGENT_METRICS_HISTORY_ENABLED=true
AGENT_METRICS_HISTORY_DEFAULT_WINDOW_SEC=900
AGENT_METRICS_HISTORY_MAX_WINDOW_SEC=86400
AGENT_METRICS_HISTORY_DEFAULT_BUCKET_SEC=60
AGENT_METRICS_HISTORY_MAX_BUCKET_SEC=900
AGENT_METRICS_HISTORY_QUEUE_SIZE=4096
AGENT_METRICS_HISTORY_BATCH_SIZE=128
AGENT_METRICS_HISTORY_FLUSH_SEC=2
