# PathMind Agent Service Environment
PATHMIND_DEBUG=false
PATHMIND_GO_BACKEND_URL=http://127.0.0.1:18080/api
PATHMIND_ANTHROPIC_API_KEY=your-api-key-here
PATHMIND_ANTHROPIC_BASE_URL=https://api.anthropic.com
PATHMIND_DEFAULT_MODEL=claude-sonnet-4.6
PATHMIND_HAIKU_MODEL=claude-haiku-4.5
PATHMIND_OPUS_MODEL=claude-sonnet-4.6
PATHMIND_NVIDIA_API_KEY=your-nvidia-api-key-here
PATHMIND_OPENAI_DEFAULT_MODEL=qwen/qwen3-next-80b-a3b-instruct
PATHMIND_NVIDIA_EMBED_MODEL=baai/bge-m3
PATHMIND_NVIDIA_CODE_EMBED_MODEL=nvidia/nv-embedcode-7b-v1
PATHMIND_NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
PATHMIND_NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nemoretriever-300m-embed-v2
PATHMIND_RAG_PREFER_TEXT_EXTRACTION=true
PATHMIND_RAG_USE_STRUCTURED_PARSER=false
PATHMIND_RAG_RERANK_ENABLED=true
PATHMIND_RAG_RERANK_MAX_CANDIDATES=24
PATHMIND_RAG_RERANK_MAX_CHARS=800
PATHMIND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathmind
PATHMIND_REDIS_URL=redis://localhost:6379/0
PATHMIND_AGENT_DELEGATION_ENABLED=true
PATHMIND_AGENT_DELEGATION_MAX_DEPTH=2

# Uvicorn runtime (P4-1B)
PATHMIND_UVICORN_WORKERS=1
PATHMIND_UVICORN_TIMEOUT_KEEP_ALIVE_S=30
PATHMIND_UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN_S=30
PATHMIND_UVICORN_LIMIT_CONCURRENCY=0
PATHMIND_UVICORN_BACKLOG=2048
PATHMIND_UVICORN_LOG_LEVEL=info

# Redis cache (P4-2)
PATHMIND_CACHE_ENABLED=true
PATHMIND_EMBEDDING_CACHE_ENABLED=true
PATHMIND_RAG_QUERY_CACHE_ENABLED=true
PATHMIND_EMBEDDING_CACHE_TTL_SEC=86400
PATHMIND_RAG_QUERY_CACHE_TTL_SEC=600
PATHMIND_NOTE_SEARCH_CACHE_ENABLED=true
PATHMIND_UNIFIED_SEARCH_CACHE_ENABLED=true
PATHMIND_NOTE_SEARCH_CACHE_TTL_SEC=600
PATHMIND_UNIFIED_SEARCH_CACHE_TTL_SEC=300

# Coding workflow (P5 P0)
PATHMIND_CODING_ENABLED=false
PATHMIND_CODING_APPROVALS_ENABLED=true
PATHMIND_CODING_AUDIT_ENABLED=true
PATHMIND_CODING_WORKSPACE_ROOTS=.
PATHMIND_CODING_BLOCKED_PATHS=/etc,/var,/proc,/sys,~/.ssh,~/.config
PATHMIND_CODING_ALLOWED_COMMANDS=git,python,python3,node,npm,pnpm,yarn,uv,pip,pytest,go,make,bash,sh
PATHMIND_CODING_SHELL_DEFAULT_TIMEOUT_SEC=30
PATHMIND_CODING_SHELL_MAX_TIMEOUT_SEC=300
PATHMIND_CODING_MAX_OUTPUT_CHARS=8000
PATHMIND_CODING_MAX_FILE_BYTES=10485760
PATHMIND_CODING_NETWORK_ENABLED=false
PATHMIND_CODING_APPROVAL_TIMEOUT_SEC=60
PATHMIND_EXTERNAL_MCP_BUILTIN_PRIORITY=true
PATHMIND_EXTERNAL_MCP_FALLBACK_TO_INTERNAL=true
PATHMIND_CODING_HIGH_RISK_MAX_CONCURRENCY=1
PATHMIND_CODING_LOW_RISK_RETRY_COUNT=1
PATHMIND_CODING_LOW_RISK_RETRY_BACKOFF_MS=300
PATHMIND_CODING_MEDIUM_RISK_REQUIRES_APPROVAL=true
PATHMIND_CODING_EXTERNAL_DEFAULT_RISK=high
PATHMIND_CODING_EXTERNAL_READONLY_RISK=medium
PATHMIND_CODING_EXTERNAL_OPENWORLD_RISK=high
PATHMIND_CODING_POLICY_PROFILES_ENABLED=true
PATHMIND_CODING_POLICY_PROFILES_PATH=./coding_policy_profiles.json
PATHMIND_CODING_POLICY_DEFAULT_PROFILE=strict_v1
